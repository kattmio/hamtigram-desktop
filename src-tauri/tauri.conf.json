{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HamtiGram",
  "version": "0.1.0",
  "identifier": "dev.hamtik26k.hamtigram.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HamtiGram",
        "url": "https://messenger-hamtigram.hamtik26k.workers.dev/",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": ["icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
